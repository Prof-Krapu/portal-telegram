# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to use the bot.
# Get your ID from @userinfobot. These IDs bypass the pairing step.
TELEGRAM_ALLOWED_IDS=

# Pairing token used by the /pair <token> command to enroll new users.
# If left empty, a random token is generated and printed to the console at boot.
PAIR_TOKEN=

# OpenCode server connection. Provide either OPENCODE_URL (full base URL)
# or OPENCODE_PORT (host defaults to localhost). If neither is set, the bot
# reads the first running opencode instance from ~/.portal.json.
OPENCODE_URL=
OPENCODE_PORT=4000

# Optional: working directory passed to the OpenCode client (defaults to the
# server's own cwd). Useful when one server serves multiple projects.
OPENCODE_DIRECTORY=
