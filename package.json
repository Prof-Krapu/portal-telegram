{
  "name": "portal",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "prettier": "^3.8.3",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "bot": "bun run --cwd apps/bot start",
    "bot:dev": "bun run --cwd apps/bot dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "workspaces": [
    "apps/bot",
    "packages/*"
  ],
  "packageManager": "bun@1.3.13"
}
